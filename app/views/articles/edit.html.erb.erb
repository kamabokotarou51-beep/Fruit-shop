<h1>投稿編集</h1>

<%= form_with model: @article do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :content, "投稿内容" %><br>
    <%= f.text_area :content %>
  </div>
  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>

<%= link_to "詳細に戻る", article_path(@article) %> |
<%= link_to "一覧に戻る", articles_path %>