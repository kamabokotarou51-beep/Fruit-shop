<h1>投稿詳細</h1>
<p><strong>タイトル:</strong> <%= @article.title %></p>
<p><strong>内容:</strong> <%= @article.content %></p>

<!-- 編集ページへのリンク -->
<%= link_to "編集", edit_article_path(@article) %> |
<!-- 一覧ページへのリンク -->
<%= link_to "一覧に戻る", articles_path %> |
<!-- button_toを使った削除ボタン -->
<%= button_to "削除", article_path(@article), method: :delete %>